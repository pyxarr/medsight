{
  "expo": {
    "name": "Medsight",
    "slug": "medsight",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "medsight",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo@3x.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#208AEF",
        "foregroundImage": "./assets/images/logo@3x.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo@3x.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/logo@3x.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "usePrecompiledHeaders": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8fa838f2-5994-4a7f-8cf8-511bdd5c7785"
      }
    },
    "owner": "pyxarr"
  }
}
